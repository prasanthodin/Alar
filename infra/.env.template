# Settings for infra/compose.yaml. Copy to infra/.env (git-ignored) and fill in
# the secrets. Docker Compose reads infra/.env automatically.

# --- Images -----------------------------------------------------------------
# Canonical defaults. To use a mirror (for example when Docker Hub rate-limits
# anonymous pulls), point these at it, e.g. mirror.gcr.io/library/postgres:17.
POSTGRES_IMAGE=postgres:17
REDIS_IMAGE=redis:8
FLOCI_IMAGE=floci/floci:2.5.0
CADDY_IMAGE=caddy:2
# Name given to the built commerce image (also used by bucket-init).
COMMERCE_IMAGE=shop/commerce:local
# Base image for the commerce and web images.
NODE_IMAGE=node:24-bookworm-slim

# Directory with extra CA certificates (*.crt, *.pem) trusted while building the
# images, for networks that intercept TLS. Empty by default.
BUILD_CA_DIR=./certs

# --- Addresses ----------------------------------------------------------------
CADDY_PORT=8080
# Where the site is reached (Caddy). Used for CORS and the website's metadata.
# Empty means http://localhost:${CADDY_PORT}.
PUBLIC_URL=
# Public base address of stored files, without a trailing slash. Empty means
# ${PUBLIC_URL}/catalog: Caddy serves the catalog bucket on the site's own origin.
S3_FILE_URL=
# The emulator is also published on 127.0.0.1 for host tools.
FLOCI_PORT=4566
S3_REGION=us-east-1
# PostgreSQL and Redis are published on 127.0.0.1 only, away from the default ports.
POSTGRES_PORT=55432
REDIS_PORT=56379
POSTGRES_USER=commerce

# Optional: the shop name. Commerce seeds it into the shop.name setting on the first
# migration (later renames are dated settings); the website uses it only as the
# fallback wordmark when it cannot read the settings (NEXT_PUBLIC_STORE_NAME).
STORE_NAME=

# Optional: the kernel's publishable key for the website. Empty means the website
# reads the key that commerce writes at start (restart web after the key changes,
# for example after `down -v`).
PUBLISHABLE_KEY=

# --- Secrets (required; never commit them) -------------------------------------
# Generate each with: openssl rand -hex 32
# POSTGRES_PASSWORD goes into a connection URL unescaped, so use only URL-safe
# characters: A-Z a-z 0-9 . _ ~ -
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
# Signs the Admin's preview links of unpublished Designs; at least 32 characters.
PREVIEW_TOKEN_SECRET=
# Any values work against the local emulator; staging uses real object-storage keys.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
