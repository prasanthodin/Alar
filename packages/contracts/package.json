{
  "name": "@shop/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared zod schemas and the types inferred from them (AD-19)",
  "exports": {
    ".": {
      "node": {
        "require": "./dist/cjs/index.js"
      },
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
