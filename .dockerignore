# Build context for apps/commerce/Dockerfile and apps/web/Dockerfile (repository root).
.git
**/node_modules
**/.next
**/.medusa
**/.turbo
**/.cache
**/dist
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo
**/.DS_Store
# Local env files, keys and certificates never enter an image; templates may.
**/.env*
!**/.env.template
**/*.pem
**/*.key
**/*.p12
infra/.env
infra/certs
# Not needed to build or run the applications.
_bmad
_bmad-output
docs
