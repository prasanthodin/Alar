{
  "name": "@shop/web",
  "version": "0.1.0",
  "private": true,
  "description": "Shop website on the api-client seam",
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p 8000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "analyze": "ANALYZE=true next build",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@shop/api-client": "workspace:*",
    "@shop/contracts": "workspace:*",
    "@shop/tokens": "workspace:*",
    "next": "16.3.8",
    "react": "19.0.5",
    "react-dom": "19.0.5",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.0.5",
    "@types/react-dom": "19.0.5",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.13.0",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.8",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.0.23",
    "typescript": "^6.0.3",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=24 <25"
