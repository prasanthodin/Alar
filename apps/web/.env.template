# Every variable is checked when Next.js starts (check-env-variables.js): a missing
# or malformed one stops the website with its name (never its value).

# URL of the commerce kernel. Read on the server by @shop/api-client. Required.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Optional: the kernel's address inside a container network (the compose stack sets
# http://commerce:9000). Server-side calls use it instead of the public URL when set.
# COMMERCE_INTERNAL_URL=

# The kernel's publishable key. Required.
# psql "$DATABASE_URL" -Atc "select token from api_key where type = 'publishable'"
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Public URL of the website, used for metadata and robots.txt. Optional: defaults to http://localhost:8000.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Store name shown as the wordmark until shop settings provide it. Optional.
NEXT_PUBLIC_STORE_NAME=

# Node environment (development, production, etc.)
NODE_ENV=development
