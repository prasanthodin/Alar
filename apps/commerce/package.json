{
  "name": "@shop/commerce",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "pnpm --filter @shop/contracts build && medusa develop",
    "lint": "medusa lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm run test:unit --passWithNoTests",
    "test:integration": "pnpm --filter @shop/contracts build && pnpm run test:integration:http",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1160.0",
    "@medusajs/admin-sdk": "2.23.1",
    "@medusajs/admin-shared": "2.23.1",
    "@medusajs/caching": "2.23.1",
    "@medusajs/cli": "2.23.1",
    "@medusajs/dashboard": "2.23.1",
    "@medusajs/draft-order": "2.23.1",
    "@medusajs/framework": "2.23.1",
    "@medusajs/medusa": "2.23.1",
    "@medusajs/ui": "4.3.0",
    "@shop/contracts": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "multer": "2.5.0",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.23.1",
    "@playwright/test": "1.65.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.12.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "private": true
}
