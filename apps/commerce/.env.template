# Commerce kernel environment. Checked at start-up by src/env.ts: a missing or
# malformed variable stops the kernel with its name (never its value).
# Copy to apps/commerce/.env for local development; the compose stack sets these itself.

DATABASE_URL=
# Redis 8: event bus, workflow engine and locking only (never a cache).
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# At least 8 characters each. Generate with: openssl rand -hex 32
JWT_SECRET=
COOKIE_SECRET=

# Optional: shared (default), server or worker. `medusa exec` sets server itself.
# MEDUSA_WORKER_MODE=shared

# File storage through the S3 interface. Locally this is the AWS emulator from
# infra/compose.yaml (start it with: docker compose -f infra/compose.yaml up -d floci bucket-init).
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=catalog
S3_REGION=us-east-1
# Public base address of stored files, without a trailing slash.
S3_FILE_URL=http://localhost:4566/catalog
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

DB_NAME=commerce
