{
  "name": "@shop/root",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test && node --test \"scripts/*.test.mjs\"",
    "check:name": "node scripts/check-forbidden-name.mjs",
    "commerce:dev": "turbo dev --filter=@shop/commerce",
    "web:dev": "turbo dev --filter=@shop/web"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tsconfig-paths": "^4.2.0"
    }
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "2.23.1",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.0.14"
  }
}
